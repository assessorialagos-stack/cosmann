# Copie para .env.local (no computador) ou cadastre na Vercel: Settings > Environment Variables.
# As NEXT_PUBLIC_* entram no site na hora do build: depois de mudar, faça um novo deploy.

# WhatsApp atendido pelo VendeAI: 55 + DDD + número. A PREENCHER (sem ele o deploy de produção não sobe).
# Números do material atual da Cosmann, para confirmar qual é o do VendeAI:
#   49 99942-0089 (topo e formulários do site) · 49 99923-6284 (rodapé do site) · 49 98858-4105 (placa da loja)
#   49 99925-0305 (faixa na vitrine) · fixo 49 3444-0400
NEXT_PUBLIC_WHATSAPP_NUMERO=

# CNPJ do rodapé e da política de privacidade. Sem esta variável, a página mostra o do rodapé do site
# atual (24.521.212/0001-82, "Cosmann Promota Ltda") — confirmar CNPJ e razão social com o cliente.
NEXT_PUBLIC_CNPJ=24.521.212/0001-82

# Instagram oficial da Tela A
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cosmannfinanceira/

# Endereço público do site (tags de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://consignado.cosmann.com.br

# Opcional: preenchidos, a página já instala o Google Tag Manager / pixel da Meta.
# Com o pixel por aqui (sem GTM), a página também manda Lead (Tela B salva) e Contact (clique no WhatsApp).
# Se usar GTM, deixe NEXT_PUBLIC_META_PIXEL_ID vazio e mapeie os eventos do dataLayer no GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Destino dos contatos da Tela B: URL /exec do Google Apps Script (apps-script/Codigo.gs). A PREENCHER.
# Só o servidor lê esta variável. Depois de cadastrar ou mudar, faça um Redeploy na Vercel.
SHEETS_WEBHOOK_URL=
